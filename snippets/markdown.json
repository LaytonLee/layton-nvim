{
  "Frontmatter": {
    "prefix": ["frontmatter"],
    "body": [
      "---",
      "title: ${1:title}",
      "date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND",
      "lastmod: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND",
      "categories: [${2}]",
      "tags: [$3]",
      "description: $4",
      "---",
      "",
      "$0"
    ],
    "description": "Add YAML frontmatter to markdown"
  },
  "Insert Current Date": {
    "prefix": ["cdate"],
    "body": ["$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE"],
    "description": "Insert current YYYY-MM-DD date"
  },
  "Insert Current Datetime": {
    "prefix": ["cdatetime", "now"],
    "body": [
      "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND"
    ],
    "description": "Insert current YYYY-MM-DD HH:MM:SS datetime"
  }
}
